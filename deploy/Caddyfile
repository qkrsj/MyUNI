# Caddy 가 인증서를 알아서 받고 갱신한다. 도메인만 알려주면 된다.
# HTTPS 가 없으면 비밀번호와 토큰이 평문으로 인터넷을 지나간다.
{
	email {$ACME_EMAIL}
}

{$MYUNI_DOMAIN} {
	encode gzip

	reverse_proxy myuni-server:8080 {
		# 덧붙이기가 아니라 덮어쓰기 - 클라이언트가 직접 넣은 값으로 위조하지 못하게
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output stdout
		format console
	}
}
